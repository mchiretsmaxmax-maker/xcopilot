# Скопируй в .env и заполни. .env не коммитится (chmod 600 .env).
ENV=dev
LOG_LEVEL=INFO

# Telegram
BOT_TOKEN=
OWNER_TG_IDS=

# База (внутри compose). В проде пароль свой: тот же в POSTGRES_PASSWORD и в DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://xcopilot:xcopilot@db:5432/xcopilot
# Только для compose.prod.yaml (сервис db); длинный случайный: openssl rand -hex 24
POSTGRES_PASSWORD=
# Ключ Fernet для шифрования токенов X: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=

# Модели: writer = Claude, cheap = DeepSeek, judge = Jev (TypeSafe)
DEEPSEEK_API_KEY=
# Баланс DeepSeek: проверка /user/balance раз в N часов, порог в $ (CNY по курсу), пауза задач при 402
DEEPSEEK_BALANCE_CHECK_HOURS=6
DEEPSEEK_BALANCE_MIN_USD=1
DEEPSEEK_CNY_PER_USD=7.2
DEEPSEEK_EMPTY_RETRY_MINUTES=30
DEEPSEEK_EMPTY_ALERT_HOURS=6
TYPESAFE_API_KEY=

# Каталог config/ (models.toml, pricing.toml); по умолчанию ./config
# XCOPILOT_CONFIG_DIR=

# Пояс и дневные лимиты в долларах
DEFAULT_TZ=Europe/Minsk
LLM_DAILY_LIMIT_USD=5
X_DAILY_LIMIT_USD=1
X_LOOKUP_DAILY_LIMIT_USD=0.5

# X: адрес возврата OAuth (тот же — в настройках приложения на developer.x.com)
# Чтение публичных постов по ссылке без ключа (oEmbed + fxtwitter); 0 — только oEmbed
X_PUBLIC_READ=1
X_REDIRECT_URI=http://127.0.0.1:8765/x/callback

# Папка данных приложения (временные файлы ингеста — data/ingest); в .gitignore
DATA_DIR=data

# Писатель использует Codex CLI (вход в ChatGPT через `codex login`).
# CODEX_CLI_PATH=codex
# CODEX_CLI_EFFORT=medium
# CODEX_CLI_TIMEOUT=180
# CODEX_CLI_CONCURRENCY=3

# ── Прод (этап 15, docs/runbook.md) ──────────────────────────────────────────────────────
# Compose на сервере читает прод-файл (scripts/backup.sh и smoke.sh — тоже):
# COMPOSE_FILE=compose.prod.yaml

# Бэкап (scripts/backup.sh, cron на хосте раз в сутки). Не настройки приложения — читают скрипты.
# Папка дампов на хосте
BACKUP_DIR=backups
# Файл с паролем шифрования (chmod 600, НЕ в репозитории); пусто — дамп без шифрования
BACKUP_PASSPHRASE_FILE=
# Куда копировать дамп на другой хост (rsync): user@host:/srv/xcopilot-backups/ ; пусто — не копировать
BACKUP_REMOTE=
# Сколько дней хранить дампы локально
BACKUP_KEEP_DAYS=14

# ── Режим на устройстве и перенос (docs/runbook.md, «Перенос на другое устройство») ─────
# БД в Docker (compose.yaml + compose.local.yaml), порт на 127.0.0.1; scripts/run_local.sh
# сам подменяет хост `db` на 127.0.0.1:5433. Скрипты setup/service/transfer читают:
# RUN_LOCAL_DB_PORT=5433
# Файл с паролем пакета переноса (chmod 600, НЕ в репозитории); пусто — спросят в терминале
# XC_TRANSFER_PASSPHRASE_FILE=

# ── Внешний сторож (аудит I, docs/runbook.md, раздел 12) ─────────────────────────────────
# Адрес пульса во внешней службе-стороже (healthchecks.io и т.п.); пусто — сторож выключен. Секрет.
HEARTBEAT_URL=
# Как часто слать пульс, секунд
HEARTBEAT_INTERVAL=60
