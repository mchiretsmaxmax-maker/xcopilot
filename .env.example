# Скопируй в .env и заполни. .env не коммитится (chmod 600 .env).
ENV=dev
LOG_LEVEL=INFO

# Telegram
BOT_TOKEN=
OWNER_TG_IDS=

# База (внутри compose)
DATABASE_URL=postgresql+asyncpg://xcopilot:xcopilot@db:5432/xcopilot
# Ключ Fernet для шифрования токенов X: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=

# Модели: writer = Claude, cheap = DeepSeek, judge = Jev (TypeSafe)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
TYPESAFE_API_KEY=

# Каталог config/ (models.toml, pricing.toml); по умолчанию ./config
# XCOPILOT_CONFIG_DIR=

# Пояс и дневные лимиты в долларах
DEFAULT_TZ=Europe/Minsk
LLM_DAILY_LIMIT_USD=5
X_DAILY_LIMIT_USD=1
